using "./chords/default.chords";
using "./529_lua_script_support_gen.lua";

device: SC1 _isType="midi" _useDevice="FLUID";
instrumentDef: piano      SC1 _ch=0 _pc=0;
instrumentDef: bass      SC1 _ch=1 _gmInstrument="Electric Bass Finger";

tempo: 150;

[
instrument: piano;
template: tmpl;
{
    <I, V, III VII>1
}
]

[
instrument: bass;
template: tmpl;
{
   I,,4 & & &
}
]


[
type: accomp;
{
    /call: "529_lua_script_support_gen" _t1="tmpl"/ r1
}
]